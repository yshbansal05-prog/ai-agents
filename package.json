{
  "name": "ai-organization-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Agent Enterprise Organization Orchestrator",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "frontend": "npm run dev --prefix frontend",
    "backend": "python backend/main.py",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix frontend",
    "test:backend": "pytest backend/tests",
    "test:pipeline": "python backend/test_pipeline.py",
    "test": "npm run test:backend && npm run build",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "x402": "node x402_service/server.js"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "^10.0.0-alpha.39",
    "@tinymanorg/tinyman-js-sdk": "^5.1.4",
    "@x402-avm/avm": "^2.6.1",
    "@x402-avm/core": "^2.6.1",
    "@x402-avm/express": "^2.6.1",
    "algosdk": "^3.7.0",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  }
}
