# =========================================================
# AI Organization .gitignore
# =========================================================

# Environment & Secrets
.env
.env.local
.env.*.local
*.env
*.key
*.pem

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
backend/.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Local SQLite Databases & WAL
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/*.db

# Node.js & Next.js Build Artifacts
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
dist/
*.tsbuildinfo
frontend/*.tsbuildinfo

# Logs & Debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Docker & Storage
pgdata/
data/

# OS & Editor Artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
