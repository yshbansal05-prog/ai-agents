# =========================================================
# AI Organization - Environment Configuration
# =========================================================

# LLM Provider Configuration
# Supported providers: gemini, openai, groq, nvidia, local, ollama, vllm
LLM_PROVIDER=gemini

# Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# NVIDIA NIM / Local NVIDIA GPU Configuration
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=nvapi-your_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
LLM_TIMEOUT=75.0

# Local GPU Server (Ollama / vLLM / LM Studio / LocalAI)
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1
LOCAL_LLM_API_KEY=local-key

# Database Configuration
# Local SQLite fallback: sqlite+aiosqlite:///./ai_org.db
# Production PostgreSQL: postgresql+asyncpg://ai_user:ai_secure_password@localhost:5432/ai_org
DATABASE_URL=sqlite+aiosqlite:///./ai_org.db

# Docker Compose PostgreSQL Settings
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=ai_secure_password
POSTGRES_DB=ai_org
POSTGRES_PORT=5432

# Backend Service Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*

# Frontend Service Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/company

# =========================================================
# x402 Payment Protocol & Algorand Testnet Configuration
# =========================================================
X402_NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=
AVM_ADDRESS=BJSAKUOZAQJGH2Y3LEPVVJY5HLKEPP6EI4XFNOZPBVE4VBVVCNZUB434CQ
AVM_PRIVATE_KEY=your_base64_private_key_or_mnemonic_here
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
ALGOD_TESTNET_URL=https://testnet-api.algonode.cloud
USDC_TESTNET_ASA_ID=10458941
X402_SERVICE_URL=http://localhost:8002

